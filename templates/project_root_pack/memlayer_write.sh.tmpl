#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_PATH="${SCRIPT_DIR}/memlayer.config.json"
QUEUE_PATH="${SCRIPT_DIR}/memlayer.offline.queue.jsonl"
LOG_PATH="${SCRIPT_DIR}/memlayer.offline.log.md"

usage() {
  cat >&2 <<'USAGE'
usage:
  ./memlayer_write.sh <memory|task-log> '<json-payload>'
  ./memlayer_write.sh --type <decision|constraint|risk|artifact|task|note|event|task_outcome|outcome|log> --title <title> --content <content> [--importance N] [--metadata JSON]

examples:
  ./memlayer_write.sh memory '{"type":"task","title":"Done","content":"Outcome"}'
  ./memlayer_write.sh --type task_outcome --title "Inventory done" --content "source inventory ready"
USAGE
}

KIND="memory"
PAYLOAD=""

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ "${1:-}" == --* ]]; then
  MEMORY_TYPE=""
  TITLE=""
  CONTENT=""
  IMPORTANCE="3"
  METADATA="{}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --kind)
        KIND="${2:-}"
        shift 2
        ;;
      --type)
        MEMORY_TYPE="${2:-}"
        shift 2
        ;;
      --title)
        TITLE="${2:-}"
        shift 2
        ;;
      --content|--body)
        CONTENT="${2:-}"
        shift 2
        ;;
      --importance)
        IMPORTANCE="${2:-}"
        shift 2
        ;;
      --metadata)
        METADATA="${2:-}"
        shift 2
        ;;
      *)
        echo "memlayer_write.sh: unsupported option $1" >&2
        usage
        exit 2
        ;;
    esac
  done

  if [[ -z "${MEMORY_TYPE}" || -z "${TITLE}" || -z "${CONTENT}" ]]; then
    echo "memlayer_write.sh: --type, --title, and --content are required for flag-style writes" >&2
    usage
    exit 2
  fi

  PAYLOAD="$(python3 - "$MEMORY_TYPE" "$TITLE" "$CONTENT" "$IMPORTANCE" "$METADATA" <<'PY'
import json
import sys

memory_type, title, content, importance_text, metadata_text = sys.argv[1:6]
try:
    importance = int(importance_text)
except ValueError as exc:
    raise SystemExit("--importance must be an integer") from exc
try:
    metadata = json.loads(metadata_text)
except json.JSONDecodeError as exc:
    raise SystemExit(f"--metadata must be a JSON object: {exc}") from exc
if not isinstance(metadata, dict):
    raise SystemExit("--metadata must be a JSON object")
print(json.dumps(
    {
        "type": memory_type,
        "title": title,
        "content": content,
        "importance": importance,
        "metadata": metadata,
    },
    ensure_ascii=False,
))
PY
)"
else
  KIND="${1:-memory}"
  PAYLOAD="${2:-}"
fi

if [[ -z "${PAYLOAD}" ]]; then
  usage
  exit 1
fi

case "${KIND}" in
  memory) ENDPOINT="/memory" ;;
  task-log) ENDPOINT="/task-logs" ;;
  *)
    echo "memlayer_write.sh: unsupported kind ${KIND}; allowed kinds: memory, task-log" >&2
    usage
    exit 1
    ;;
esac

case "${KIND}" in
  memory) PAYLOAD="$(python3 "${SCRIPT_DIR}/memlayer_payload.py" ensure-memory "${CONFIG_PATH}" "${PAYLOAD}")" ;;
  task-log) PAYLOAD="$(python3 "${SCRIPT_DIR}/memlayer_payload.py" ensure-task-log "${CONFIG_PATH}" "${PAYLOAD}")" ;;
esac

if MEMLAYER_API_RETRY_ATTEMPTS_OVERRIDE="${MEMLAYER_WRITE_RETRY_ATTEMPTS:-1}" "${SCRIPT_DIR}/memlayer_api.sh" POST "${ENDPOINT}" "${PAYLOAD}"; then
  exit 0
fi

python3 - "$QUEUE_PATH" "$LOG_PATH" "$KIND" "$ENDPOINT" "$PAYLOAD" <<'PY'
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

queue_path, log_path, kind, endpoint, payload_text = sys.argv[1:6]
payload = json.loads(payload_text)
queued_at = datetime.now(timezone.utc).isoformat()
record = {
    "queued_at": queued_at,
    "kind": kind,
    "endpoint": endpoint,
    "payload": payload,
}

with open(queue_path, "a", encoding="utf-8") as fh:
    fh.write(json.dumps(record, ensure_ascii=False) + "\n")

title = payload.get("title") or payload.get("query") or payload.get("agent_id") or "offline write"
content = payload.get("content") or payload.get("outcome") or payload.get("notes") or ""
content = " ".join(str(content).split())[:240]
lines = [
    f"- {queued_at} [{kind}] {title}",
]
if content:
    lines.append(f"  - {content}")
lines.append("  - follow-up sync needed")

with open(log_path, "a", encoding="utf-8") as fh:
    fh.write("\n".join(lines) + "\n")
PY

echo "memlayer_write.sh: live MemLayer unavailable, queued ${KIND} write in ${QUEUE_PATH}" >&2
