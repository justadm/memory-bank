#!/usr/bin/env python3
import os
from pathlib import Path
import sys


repo_root = Path(__file__).resolve().parent
local_python = repo_root / ".venv313" / "bin" / "python"
if local_python.exists() and Path(sys.executable).resolve() != local_python.resolve():
    os.execv(str(local_python), [str(local_python), *sys.argv])

from memlayer_connector.cli import main


if __name__ == "__main__":
    raise SystemExit(main())
